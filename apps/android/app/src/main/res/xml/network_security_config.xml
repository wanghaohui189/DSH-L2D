<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-11-27: remote traffic must be TLS; cleartext is allowed only for the
     on-device loopback bridge. User-installed CAs are not trusted. The relay CA
     below is additive: system CAs remain trusted, so this is NOT a strict pin.
     Scoping it to the relay host needs a fixed domain (the endpoint is
     user-configured); real pinning/rotation is tracked as a follow-up. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/relay_ca" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
