<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-11-26: remote traffic must be TLS. Cleartext is allowed only for the
     on-device loopback bridge; the relay CA is pinned below, so a user-installed
     or system CA cannot silently impersonate the relay. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/relay_ca" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
