<?xml version="1.0" encoding="utf-8"?>
<!-- 「触屏互动」说明页：和 activity_permissions.xml 同一套骨架（返回 + 标题 + 说明 + 滚动列表），
     从通话页宠物模式下的「触屏互动 · 看清单」进入。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTouchGuide" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ui_background">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/ui_bg_aurora" android:contentDescription="@null"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/ui_start_scrim" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/btnTouchGuideBack" android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center" android:text="‹" android:textColor="@color/ui_text" android:textSize="27sp"
                android:background="@drawable/ui_glass_button" android:contentDescription="返回通话页"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:text="触屏互动" android:textColor="@color/ui_text"
                android:textSize="19sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/touchGuideCount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/ui_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView android:id="@+id/touchGuideIntro" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:lineSpacingExtra="3dp"
            android:text="触屏互动开着（宠物模式）时，摸她身上的这些地方会有反应。身体动作和表情是她本机演的，台词是预渲染语音，不走模型、不耗对话。"
            android:textColor="@color/ui_text_secondary" android:textSize="12sp"/>

        <ScrollView android:id="@+id/touchGuideScroll" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"
            android:scrollbars="none" android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="vertical">
            <LinearLayout android:id="@+id/touchGuideRows" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingBottom="8dp"/>
        </ScrollView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:lineSpacingExtra="2dp"
            android:text="单击同一处有两句台词轮换；双击换一种反应；连戳三下有单独的生气反应。按住腰是狗尾草，按住尾巴是她自己的 13 秒挣脱动作。"
            android:textColor="@color/ui_text_muted" android:textSize="10sp"/>
    </LinearLayout>
</FrameLayout>
