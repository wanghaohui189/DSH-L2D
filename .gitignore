logs/

# Binary release artifacts and separately provisioned assets
*.apk
*.aab
*.so
*.aar
*.mnn
*.onnx
*.gguf
models/
assets-private/

# The relay trust anchor is a public certificate (no private key); it must ship with the app.
!apps/android/app/src/main/res/raw/relay_ca.pem

